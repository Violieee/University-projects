<Window x:Class="lab5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вкладники банку" Height="600" Width="900"
        MinWidth="850" MinHeight="480"
        WindowStartupLocation="CenterScreen" Language="uk-UA">
    <!-- Структура інтерфейсу відповідає прикладу з лабораторної:
         блок введення -> кнопка додавання -> таблиця -> нижні кнопки. -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="Додати/редагувати вкладника" FontWeight="Bold" Margin="5,0,0,6" />
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="ПІБ:" VerticalAlignment="Center" Margin="5" />
                <TextBox x:Name="FullNameTextBox" Grid.Row="0" Grid.Column="1" Margin="5" Padding="2" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="№ рахунку:" VerticalAlignment="Center" Margin="5" />
                <TextBox x:Name="AccountNumberTextBox" Grid.Row="0" Grid.Column="3" Margin="5" Padding="2" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Сума вкладу:" VerticalAlignment="Center" Margin="5" />
                <TextBox x:Name="AmountTextBox" Grid.Row="1" Grid.Column="1" Margin="5" Padding="2" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Рік відкриття:" VerticalAlignment="Center" Margin="5" />
                <TextBox x:Name="YearOpenedTextBox" Grid.Row="1" Grid.Column="3" Margin="5" Padding="2" />
            </Grid>
            <Button x:Name="AddButton" Content="Додати вкладника" Margin="5" Padding="4,3"
                    Click="AddButton_Click" />
        </StackPanel>

        <DataGrid x:Name="DepositorsDataGrid" Grid.Row="1"
                  ItemsSource="{Binding Deposits}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single"
                  Margin="0,10,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ПІБ" Binding="{Binding FullName}" Width="*" />
                <DataGridTextColumn Header="№ рахунку" Binding="{Binding AccountNumber}" Width="*" />
                <DataGridTextColumn Header="Сума вкладу, грн" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="*" />
                <DataGridTextColumn Header="Рік відкриття" Binding="{Binding YearOpened}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <TextBlock Text="Фільтрувати за роком:" VerticalAlignment="Center" Margin="5" />
            <TextBox x:Name="FilterYearTextBox" Width="58" VerticalContentAlignment="Center" Margin="5" Padding="2" />
            <Button x:Name="FilterButton" Content="Фільтр" Margin="4" Padding="5,2" Click="FilterButton_Click" />
            <Button x:Name="DeleteButton" Content="Видалити" Margin="4" Padding="5,2" Click="DeleteButton_Click" />
            <Button x:Name="SortByAmountButton" Content="Сортувати за сумою" Margin="4" Padding="5,2" Click="SortByAmountButton_Click" />
            <Button x:Name="LoadButton" Content="Завантажити" Margin="4" Padding="5,2" Click="LoadButton_Click" />
            <Button x:Name="SaveButton" Content="Зберегти" Margin="4" Padding="5,2" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
